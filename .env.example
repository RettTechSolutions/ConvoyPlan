# Database
POSTGRES_USER=convoyplan
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=convoyplan

# JWT — generate with: openssl rand -hex 32
# In production the backend refuses to start if this is left at the default
# or is shorter than 32 characters (set APP_ENV=development to relax locally).
JWT_SECRET=change-me-generate-a-real-secret

# Deployment environment: production (default, enforces a strong JWT_SECRET)
# or development (relaxes the check for local work).
APP_ENV=production

# Optional Fernet key (urlsafe-base64, 32 bytes) to encrypt MFA secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When empty, a key is derived from JWT_SECRET (rotating JWT_SECRET then makes
# existing MFA secrets unreadable — users must re-enrol MFA).
# MFA_ENCRYPTION_KEY=

# CORS allowlist (comma-separated origins) or "*". Leave empty in production to
# default to APP_BASE_URL's own origin (frontend and API are same-origin).
# CORS_ORIGINS=https://convoy.yourdomain.com

# Reject new passwords found in the Have I Been Pwned breach corpus (k-anonymity,
# fails open if the service is unreachable). Set to false for air-gapped setups.
# PASSWORD_BREACH_CHECK_ENABLED=true

# Enforce the Content-Security-Policy (default: Report-Only, which never breaks
# the UI). Verify the map/routing/tracking work, then set this to true.
# CSP_ENFORCE=false

# Hourly per-caller budgets for the endpoints that spend a metered upstream
# quota. Demo sessions (POST /api/auth/demo-session — free to obtain) get the
# smaller budget so one of them cannot drain the instance's HERE/TomTom credits
# or pin GraphHopper's CPU. Set a value to 0 to disable that throttle.
# QUOTA_ROUTING_PER_HOUR=240         # GraphHopper route calculations
# QUOTA_ROUTING_DEMO_PER_HOUR=40
# QUOTA_GEOCODE_PER_HOUR=600         # HERE / Photon address search
# QUOTA_GEOCODE_DEMO_PER_HOUR=100
# QUOTA_TRAFFIC_PER_HOUR=600         # HERE / TomTom live traffic flow
# QUOTA_TRAFFIC_DEMO_PER_HOUR=100

# Ephemeral demo sessions (public "Demo ausprobieren" button). The admin panel
# settings win over these fallbacks; the values here apply until one is saved.
# DEMO_ENABLED=false
# DEMO_SESSION_HOURS=24              # lifetime of a new demo session
# One demo session per client IP and cooldown window, enforced against the
# demo_origins table (survives a backend restart, unlike the in-process limiter)
# and outliving the demo org itself. 0 disables the cooldown.
# DEMO_IP_COOLDOWN_HOURS=24

# Backups (scripts/backup.sh)
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30

# Data retention (purged periodically by the `retention` container).
# RETENTION_ENABLED=true
# RETENTION_INTERVAL=3600            # seconds between purge runs
# RETENTION_POSITIONS_HOURS=24       # delete live positions older than this
# RETENTION_AUDIT_DAYS=365           # delete audit-log entries older than this
# RETENTION_SHARE_LINKS_DAYS=30      # delete revoked share links older than this

# ── Systemübersicht (Admin-Portal → Systemübersicht) ───────────────────────
# Der Collector läuft im Backend und schreibt periodisch Hardware-, Container-
# und Nutzungskennzahlen mit. Rohdaten tragen die Detailcharts, die daraus
# verdichteten Tageswerte die Monatsberichte.
# SYSTEM_METRICS_ENABLED=true
# SYSTEM_METRICS_INTERVAL=300              # Sekunden zwischen zwei Stichproben
# SYSTEM_METRICS_RETENTION_DAYS=90         # Aufbewahrung der Rohstichproben
# SYSTEM_METRICS_DAILY_RETENTION_DAYS=1095 # Aufbewahrung der Tageswerte (Berichte)
# Pfade, deren Belegung erfasst wird (kommasepariert). Pfade auf demselben
# Dateisystem werden automatisch zusammengefasst.
# SYSTEM_METRICS_DISK_PATHS=/,/uploads,/update_status
#
# Container-Zustände (Docker-Health) holt das Backend über den Sidecar
# `dockerproxy`, der nur lesende Aufrufe durchlässt. Der rohe Docker-Socket
# im von außen erreichbaren Backend wäre gleichbedeutend mit Root auf dem Host —
# deshalb der Umweg. Ganz ohne Sidecar: DOCKER_METRICS_ENABLED=false setzen
# (alle übrigen Kennzahlen bleiben verfügbar).
# DOCKER_METRICS_ENABLED=true
# DOCKER_API_URL=http://dockerproxy:2375   # alternativ unix:///var/run/docker.sock
# DOCKER_STATS_ENABLED=true                # CPU/RAM je Container mitmessen
# DOCKER_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:0.3.0
# DOCKER_SOCKET_PATH=/var/run/docker.sock  # Pfad des Sockets auf dem HOST

# Superadmin account is created via the first-run setup wizard at /setup

# SSL / Caddy
DOMAIN=convoy.yourdomain.com
ACME_EMAIL=admin@yourdomain.com
HTTP_PORT=80
HTTPS_PORT=443

# Custom cert (optional — leave empty for auto Let's Encrypt)
# CADDY_TLS_CERT=/certs/cert.pem
# CADDY_TLS_KEY=/certs/key.pem
# CERT_DIR=/path/to/your/certs

# Host paths bind-mounted into containers. The installer sets these to absolute
# paths automatically; for a manual `git clone` deploy the compose defaults
# (./caddy/entrypoint.sh and the self-discovering updater) work as-is.
# CADDY_ENTRYPOINT_PATH=/opt/convoyplan/caddy/entrypoint.sh
# STACK_FILE_PATH=/opt/convoyplan/docker-compose.yml
# COMPOSE_PROJECT_NAME=convoyplan

# GraphHopper region (smaller = faster first start)
# OSM_DOWNLOAD_URL=https://download.geofabrik.de/europe/germany/bayern-latest.osm.pbf
# OSM_FILENAME=bayern-latest.osm.pbf

# WebSocket host override for local dev without Caddy (optional)
# VITE_WS_HOST=localhost:8000

# Auto-updater (required for the System tab in Admin → Software-Update)
# GITHUB_TOKEN=ghp_...          GitHub PAT with repo read access (classic: repo scope)
# GITHUB_REPO=RettTechSolutions/ConvoyPlan   leave at default unless you forked
# UPDATE_CHANNEL=stable         Release channel fallback: "stable" deploys only
#                               published GitHub releases (recommended), "beta"
#                               tracks every commit on main. The admin-panel
#                               toggle (Admin → Software-Update) overrides this.
# UPDATE_MODE=auto              Update mode fallback: "auto" installs channel
#                               updates automatically, "notify" only emails the
#                               superadmins (install via "Jetzt updaten").
#                               The admin-panel toggle overrides this.
# UPDATE_NOTIFY_INTERVAL=1800   How often (seconds) the backend checks whether
#                               an update notification is due (mode "notify"
#                               and UPDATE_NOTIFY_ON_AUTO).
# UPDATE_NOTIFY_ON_AUTO=false   Optional: email the superadmins AFTER an update
#                               was installed automatically (mode "auto").
#                               The admin-panel checkbox overrides this.

# License key (issued by ConvoyPlan)
# LICENSE_KEY=CP-...

# ── Live-Verkehrslage (Stau/Fließgeschwindigkeit) ──────────────────────────
# Optional. Vorbereitet, aber inaktiv, solange kein Key gesetzt ist. Sobald ein
# eigener API-Key hinterlegt wird, blendet die App die Verkehrslage (grün→rot)
# entlang der Route ein. Kostenlose Tarife: HERE (250k Anfragen/Monat) oder
# TomTom. Hinweis: Die Anzeige dieser Daten auf der OSM-Basiskarte kann
# lizenzpflichtig sein — Nutzungsbedingungen des Anbieters vor Produktivbetrieb
# prüfen.
# Tipp: Die Keys lassen sich alternativ (und bequemer) im Superadmin-Bereich
# unter Admin → „Live-Verkehrslage" eintragen; ein dort gesetzter Wert hat
# Vorrang vor diesen Umgebungsvariablen.
# HERE_TRAFFIC_API_KEY=
# TOMTOM_TRAFFIC_API_KEY=
# TRAFFIC_FLOW_PROVIDER=        Optional: "here"/"tomtom" erzwingen, wenn beide
#                               Keys gesetzt sind (leer = automatisch, HERE bevorzugt).

# ── Adresssuche (Geocoding) ────────────────────────────────────────────────
# Optional. Ist ein HERE-Key gesetzt, läuft die Adresssuche im Plan-Editor über
# HERE Geocoding & Search (der Key bleibt serverseitig, das Frontend fragt nur
# den Backend-Proxy /api/geocode/search an). Ohne Key fällt die Suche
# automatisch auf das offene, schlüssellose Photon (komoot) zurück.
# HERE gibt EINEN Key für alle Produkte aus: Ist HERE_API_KEY leer, wird der
# oben gesetzte HERE_TRAFFIC_API_KEY (bzw. der im Admin-Panel hinterlegte
# Traffic-Key) automatisch mitbenutzt — der Key muss also nur einmal hinterlegt
# werden.
# HERE_API_KEY=
#
# Kostendeckel: maximale HERE-Anfragen pro Kalendermonat. Ist der Deckel
# erreicht, fällt die Adresssuche für den Rest des Monats automatisch auf das
# kostenlose Photon zurück — kein Ausfall, keine Kosten. HEREs Base-Plan enthält
# 30.000 Transaktionen/Monat gratis; der Standard 25.000 lässt bewusst Puffer.
# 0 = kein App-Deckel (dann greift nur HEREs eigenes Kontingent).
# HERE_MONTHLY_LIMIT=25000

# ── Offene Baustellen-/Sperrungs-Feeds (Open Data, kostenlos) ──────────────
# Kommaseparierte Liste "format|url". Formate: mobidata_bw / berlin_viz (GeoJSON)
# und datex2 (DATEX II v2, z. B. mobilithek-Länderfeeds für bundesweite
# Abdeckung). Standard aktiviert BW + Berlin.
# OPENDATA_TRAFFIC_ENABLED=true
# OPENDATA_TRAFFIC_FEEDS=mobidata_bw|https://api.mobidata-bw.de/datasets/traffic/roadworks/roadworks_geojson.json,berlin_viz|https://api.viz.berlin.de/daten/baustellen_sperrungen_viz.json
# Client-Zertifikat für per mTLS geschützte datex2-Feeds (mobilithek-Broker):
# Lege die Datei auf dem Host im Ordner ./secrets neben der docker-compose.yml
# ab — im Container ist sie unter /secrets erreichbar (read-only gemountet). Sie
# muss dem Container-User (appuser, UID 1001) gehören:
#   openssl pkcs12 -in certificate.p12 -out secrets/mobilithek-client.pem -nodes
#   sudo chown 1001:1001 secrets/mobilithek-client.pem && chmod 600 secrets/mobilithek-client.pem
# GEHEIM (privater Schlüssel), nie ins Git!
# OPENDATA_TRAFFIC_CLIENT_CERT=/secrets/mobilithek-client.pem
#
# Hinweis mobilithek-Broker: Der Broker (mobilithek.info:8443) nutzt ein
# ÖFFENTLICHES Telekom-Serverzertifikat — die CA-Verifikation läuft über den
# System-Truststore. OPENDATA_TRAFFIC_CA_CERT deshalb NICHT setzen! Diese Option
# ist nur für Broker mit einer wirklich privaten CA gedacht; ein Setzen der
# mobilithek-„CA-Kette" bricht die TLS-Verbindung (self-signed cert in chain).
# OPENDATA_TRAFFIC_CA_CERT=
